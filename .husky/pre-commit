#!/usr/bin/env sh
# Husky pre-commit hook: enforce 4 verifications + determinism guard
# 2026-10-03 bun→pnpm 移行

echo "[pre-commit] Running typecheck..."
pnpm run typecheck || exit 1

echo "[pre-commit] Running biome lint..."
pnpm exec biome lint . || exit 1

echo "[pre-commit] Running determinism guard..."
pnpm run check:determinism || exit 1

echo "[pre-commit] Running unit tests..."
pnpm run test:unit || exit 1

# Build is heavy for pre-commit; run in CI (quality-gates.yml)
# Uncomment to enforce locally:
# echo "[pre-commit] Running build..."
# pnpm run build || exit 1

echo "[pre-commit] All checks passed"
