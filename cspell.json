{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": [
    "packages/**/src/**/*.ts",
    "apps/gameserver/src/**/*.ts",
    "apps/web/src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "_tests_/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignorePaths": ["node_modules", "dist", ".next", "logs", "reports", "coverage", "bun.lock"],
  "ignoreRegExpList": [
    "/[^\\x00-\\x7F]+/g",
    "/\\b0x[0-9a-fA-F]+\\b/g",
    "/[a-zA-Z0-9+/]{32,}={0,2}/g"
  ],
  "words": [
    "accum",
    "akia",
    "amped",
    "bcast",
    "biomejs",
    "bitecs",
    "bpras",
    "buildx",
    "bunx",
    "camo",
    "CAMOS",
    "codm",
    "createdb",
    "ctlcluster",
    "datname",
    "deathmatch",
    "dequantize",
    "dequantized",
    "dequantizes",
    "dyaw",
    "gamemode",
    "gameserver",
    "gltf",
    "gunsmith",
    "hitreg",
    "hitscan",
    "interp",
    "jsonc",
    "keybind",
    "keybinds",
    "keyrings",
    "killstreak",
    "killstreaks",
    "Kuro",
    "lerp",
    "libsql",
    "loadout",
    "loadouts",
    "lockstep",
    "merc",
    "mkdir",
    "nala",
    "Neko",
    "netcode",
    "newgrp",
    "nohup",
    "nowrap",
    "numa",
    "opsz",
    "overlayfs",
    "pgdata",
    "pgid",
    "pointerlock",
    "proot",
    "quantizes",
    "raycast",
    "respawn",
    "respawns",
    "runuser",
    "scoreboard",
    "scorestreak",
    "scorestreaks",
    "setsid",
    "stim",
    "struct",
    "structs",
    "tacticals",
    "tsgo",
    "typecheck",
    "udocker",
    "unstage",
    "voxel",
    "voxels",
    "wallbang",
    "wght",
    "xoroshiro",
    "xorshift",
    "xoshiro"
  ],
  "allowCompoundWords": true
}
