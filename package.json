{
  "name": "cod-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based multi-type game platform prototype using Bun, React, and Babylon.js.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:packages": "pnpm --filter @cod/protocol build && pnpm --filter @cod/engine-core build && pnpm --filter @cod/profile-fps build",
    "build:apps": "pnpm --filter @cod/gameserver build && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "start": "tsx scripts/execute.ts",
    "server": "pnpm --filter @cod/gameserver start",
    "server:dev": "pnpm --filter @cod/gameserver dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:determinism": "tsx scripts/check-determinism.ts",
    "check:determinism:heavy": "tsx scripts/determinism-heavy.ts",
    "check:all": "tsx scripts/check-all.ts",
    "check:env": "tsx scripts/check-env.ts",
    "verify:docs": "tsx scripts/verify-docs.ts",
    "security:check": "tsx scripts/check-security.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "spell": "cspell --no-progress --relative",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "bun": "1.4.0",
    "cspell": "^10.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "tsx": "^4.20.6"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "bun",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
