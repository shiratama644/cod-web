{
  "name": "cod-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based multi-type game platform prototype using Bun, React, and Babylon.js.",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "cd packages/protocol && bun run build && cd ../engine-core && bun run build && cd ../profile-fps && bun run build",
    "build:apps": "cd apps/gameserver && bun run build && cd ../web && bun run build",
    "preview": "cd apps/web && bun run preview",
    "start": "bun run scripts/execute.ts",
    "server": "cd apps/gameserver && bun run start",
    "server:dev": "cd apps/gameserver && bun run dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:destroy": "docker compose down -v",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U postgres -d app_db",
    "db:push": "cd apps/web && bun run db:push",
    "app:up": "docker compose --profile app up --build -d",
    "app:down": "docker compose --profile app down",
    "app:logs": "docker compose --profile app logs -f",
    "docker:build:web": "docker build --target web -t cod-web-web .",
    "docker:build:gameserver": "docker build --target gameserver -t cod-web-gameserver .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:determinism": "bun run scripts/check-determinism.ts",
    "check:determinism:heavy": "bun run scripts/determinism-heavy.ts",
    "check:all": "bun run scripts/check-all.ts",
    "check:env": "bun run scripts/check-env.ts",
    "verify:docs": "bun run scripts/verify-docs.ts",
    "security:check": "bun run scripts/check-security.ts",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "spell": "cspell --no-progress --relative",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "bun": "1.4.0",
    "cspell": "^10.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  }
}
