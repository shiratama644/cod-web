{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["packages/protocol/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/protocol は最下層の protocol package です。他の @cod package へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/engine-core/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/engine-core はタイプ非依存の L1 です。profile / app 実装はコンストラクタ注入や公開インターフェース経由にしてください。"
                  },
                  {
                    "group": ["three", "three/**", "three-mesh-bvh", "@react-three/fiber"],
                    "message": "@cod/engine-core に描画・物理実装詳細を持ち込まないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/profile-fps/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/profile-fps は L2 profile です。app 層や他 profile へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/profile-voxel/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/profile-voxel は L2 profile です。app 層や他 profile へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["gamemodes/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/protocol",
                      "@cod/protocol/**",
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "gamemodes/* は gamemode-sdk のみ import できます（UGC sandbox境界）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "WebSocket": "WebSocket の直接参照は net transport 実装に限定してください。ゲームコードは NetTransport を使います。"
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**"
                    ],
                    "message": "@cod/web は server / engine-core / gamemode-sdk へ直接依存しないでください。protocol / profile / net 境界を使います。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/game/net/websocket.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/**/*.{ts,tsx}", "apps/web/src/store/**/*.{ts,tsx}", "apps/web/src/hub/**/*.{ts,tsx}", "apps/web/src/shell/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@babylonjs/core", "@babylonjs/core/**", "@babylonjs/loaders", "@babylonjs/loaders/**"],
                    "message": "hub / store / components は Babylon.js を直接 import しないでください。Babylon は game/babylon 層のみで使用します。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/game/babylon/**/*.{ts,tsx}", "apps/web/src/game/net/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
