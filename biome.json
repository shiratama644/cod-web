{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/protocol/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/protocol \u306f\u6700\u4e0b\u5c64\u306e protocol package \u3067\u3059\u3002\u4ed6\u306e @cod package \u3078\u4f9d\u5b58\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/engine-core/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/engine-core \u306f\u30bf\u30a4\u30d7\u975e\u4f9d\u5b58\u306e L1 \u3067\u3059\u3002profile / app \u5b9f\u88c5\u306f\u30b3\u30f3\u30b9\u30c8\u30e9\u30af\u30bf\u6ce8\u5165\u3084\u516c\u958b\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u7d4c\u7531\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
                  },
                  {
                    "group": [
                      "three",
                      "three/**",
                      "three-mesh-bvh",
                      "@react-three/fiber"
                    ],
                    "message": "@cod/engine-core \u306b\u63cf\u753b\u30fb\u7269\u7406\u5b9f\u88c5\u8a73\u7d30\u3092\u6301\u3061\u8fbc\u307e\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/profile-fps/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/profile-fps \u306f L2 profile \u3067\u3059\u3002app \u5c64\u3084\u4ed6 profile \u3078\u4f9d\u5b58\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/profile-voxel/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/profile-voxel \u306f L2 profile \u3067\u3059\u3002app \u5c64\u3084\u4ed6 profile \u3078\u4f9d\u5b58\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "gamemodes/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/protocol",
                      "@cod/protocol/**",
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "gamemodes/* \u306f gamemode-sdk \u306e\u307f import \u3067\u304d\u307e\u3059\uff08UGC sandbox\u5883\u754c\uff09\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/gamemode-api/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**",
                      "three",
                      "three/**",
                      "three-mesh-bvh"
                    ],
                    "message": "@cod/gamemode-api \u306f L1 core \u3067\u3059\u3002protocol \u306e\u307f\u4f9d\u5b58\u3001profile/app/sdk \u3078\u4f9d\u5b58\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/gamemode-sdk/src/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/protocol",
                      "@cod/protocol/**",
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**",
                      "three",
                      "three/**",
                      "three-mesh-bvh"
                    ],
                    "message": "@cod/gamemode-sdk \u306f gamemode-api \u306e facade \u3067\u3059\u3002api \u4ee5\u5916\u306e @cod package \u3078\u76f4\u63a5\u4f9d\u5b58\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "_tests_/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!apps/web/**"
    ]
  }
}
