{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "quoteStyle": "double"
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "auto"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["packages/protocol/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/protocol は最下層の protocol package です。他の @cod package へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/engine-core/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/engine-core はタイプ非依存の L1 です。profile / app 実装はコンストラクタ注入や公開インターフェース経由にしてください。"
                  },
                  {
                    "group": ["three", "three/**", "three-mesh-bvh", "@react-three/fiber"],
                    "message": "@cod/engine-core に描画・物理実装詳細を持ち込まないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/profile-fps/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/profile-fps は L2 profile です。app 層や他 profile へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/profile-voxel/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "@cod/profile-voxel は L2 profile です。app 層や他 profile へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["gamemodes/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/protocol",
                      "@cod/protocol/**",
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**"
                    ],
                    "message": "gamemodes/* は gamemode-sdk のみ import できます（UGC sandbox境界）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/gamemode-api/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gamemode-sdk",
                      "@cod/gamemode-sdk/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**",
                      "three",
                      "three/**",
                      "three-mesh-bvh"
                    ],
                    "message": "@cod/gamemode-api は L1 core です。protocol のみ依存、profile/app/sdk へ依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/gamemode-sdk/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cod/protocol",
                      "@cod/protocol/**",
                      "@cod/engine-core",
                      "@cod/engine-core/**",
                      "@cod/profile-fps",
                      "@cod/profile-fps/**",
                      "@cod/profile-voxel",
                      "@cod/profile-voxel/**",
                      "@cod/gameserver",
                      "@cod/gameserver/**",
                      "@cod/web",
                      "@cod/web/**",
                      "three",
                      "three/**",
                      "three-mesh-bvh"
                    ],
                    "message": "@cod/gamemode-sdk は gamemode-api の facade です。api 以外の @cod package へ直接依存しないでください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["_tests_/**/*.{ts,tsx}", "**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/tsconfig.json", "**/tsconfig.*.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ],
  "files": {
    "includes": ["**", "!.agent", "!.archive", "!logs", "!bun.lock"]
  }
}
