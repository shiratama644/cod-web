# このファイルを .env にコピーして使う: cp .env.example .env
#
# PostgreSQL 接続文字列。ルートの compose.yaml のデフォルト値と一致している。
# 未設定のままでも動く(/api/loadouts はインメモリ保存にフォールバック)。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Neon を使う場合: `neon link` / `neon deploy` がルートの .env に書き出す接続文字列を
# ここに設定する。bun run setup / bun run start はルートの .env からも自動検出し、
# リモート URL のときはローカル DB(Docker/apt)を一切起動しない。
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.aws.neon.tech/cod?sslmode=require&channel_binding=require
